{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ShitBot-Team/ShitBotUltra/api/bridge/v1/envelope.schema.json",
  "title": "ShitBotUltra Bridge v1",
  "type": "object",
  "required": ["protocol_version", "kind", "type", "message_id", "node_id", "boot_id", "sequence", "occurred_at"],
  "properties": {
    "protocol_version": { "const": 1 },
    "kind": { "enum": ["control", "event", "request", "response"] },
    "type": { "type": "string", "minLength": 1, "maxLength": 128 },
    "message_id": { "$ref": "#/$defs/id" },
    "request_id": { "$ref": "#/$defs/id" },
    "node_id": { "$ref": "#/$defs/id" },
    "boot_id": { "$ref": "#/$defs/id" },
    "sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "deadline": { "type": "string", "format": "date-time" },
    "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 30000 },
    "idempotency_key": { "$ref": "#/$defs/id" },
    "payload": {},
    "error": { "$ref": "#/$defs/error" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "request" } } },
      "then": { "required": ["request_id", "deadline", "timeout_ms"] }
    },
    {
      "if": { "properties": { "kind": { "const": "response" } } },
      "then": { "required": ["request_id"] }
    },
    {
      "if": { "properties": { "type": { "const": "hello" } } },
      "then": { "properties": { "kind": { "const": "control" }, "sequence": { "const": 0 }, "payload": { "$ref": "#/$defs/hello" } }, "required": ["payload"] }
    },
    {
      "if": { "properties": { "kind": { "const": "request" }, "type": { "const": "login.authorize" } } },
      "then": { "properties": { "payload": { "type": "object", "required": ["player"], "properties": { "player": { "$ref": "#/$defs/player" } } } }, "required": ["payload"] }
    }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "error": { "type": "object", "required": ["code", "message"], "properties": { "code": { "type": "string" }, "message": { "type": "string" } } },
    "player": {
      "type": "object",
      "required": ["name", "identity_mode"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "uuid": { "type": "string", "pattern": "^$|^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" },
        "identity_mode": { "enum": ["online", "forwarded", "offline"] }
      }
    },
    "hello": {
      "type": "object",
      "required": ["protocol_version", "adapter_version", "node_id", "network_id", "server_id", "platform", "minecraft_version", "boot_id", "capabilities"],
      "properties": {
        "protocol_version": { "const": 1 },
        "adapter_version": { "$ref": "#/$defs/id" },
        "node_id": { "$ref": "#/$defs/id" },
        "network_id": { "$ref": "#/$defs/id" },
        "server_id": { "$ref": "#/$defs/id" },
        "platform": { "$ref": "#/$defs/id" },
        "minecraft_version": { "$ref": "#/$defs/id" },
        "boot_id": { "$ref": "#/$defs/id" },
        "capabilities": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "welcome": {
      "type": "object",
      "required": ["protocol_version", "session_id", "server_time", "heartbeat_seconds", "max_message_bytes", "resume_sequence", "snapshot_required"],
      "properties": {
        "protocol_version": { "const": 1 },
        "session_id": { "$ref": "#/$defs/id" },
        "server_time": { "type": "string", "format": "date-time" },
        "heartbeat_seconds": { "const": 20 },
        "max_message_bytes": { "const": 3145728 },
        "resume_sequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "snapshot_required": { "type": "boolean" }
      }
    },
    "login_decision": {
      "type": "object",
      "required": ["allowed"],
      "properties": {
        "allowed": { "type": "boolean" },
        "reason": { "type": "string" },
        "code": { "type": "string", "pattern": "^[0-9]{8}$" },
        "expires_at": { "type": "string", "format": "date-time" }
      }
    },
    "inventory_snapshot": {
      "type": "object",
      "required": ["player", "captured_at", "format_version", "data"],
      "properties": {
        "player": { "$ref": "#/$defs/player" },
        "captured_at": { "type": "string", "format": "date-time" },
        "format_version": { "const": 1 },
        "data": { "type": "object" }
      }
    }
  },
  "x-transport": {
    "path": "/bridge/v1",
    "authentication": { "Authorization": "Bearer <node token>", "X-SBU-Node-ID": "<configured node id>" },
    "hello_timeout_seconds": 10,
    "clock_skew_allowance_seconds": 30,
    "read_queue_capacity": 64,
    "pending_action_capacity": 64,
    "compression": false,
    "reconnect": "Use the same boot_id within a game process; continue sequence above resume_sequence. The authority node sends a fresh players.snapshot first when snapshot_required is true.",
    "side_effects": "The receiving game adapter deduplicates idempotency_key within a bounded window. Core never automatically retries unconfirmed actions. Unknown results remain unknown after a game process restart.",
    "ack": "Acknowledges completed Core handling up to sequence, not delivery of external bot or game side effects. Chat delivery is a bounded at-most-once attempt."
  }
}
